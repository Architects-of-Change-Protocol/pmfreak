# ──────────────────────────────────────────────────────────────────────────
# PMFreak environment variables.
#
# See docs/security/production-deployment-boundary.md for the full
# public-vs-server-only contract this file mirrors, and
# src/lib/security/deployment-boundary-registry.ts for the enforced
# allowlists (tests/production-deployment-boundary.test.mjs fails CI if a
# NEXT_PUBLIC_* var is added here or in src/** without also being added to
# that registry).
#
# Rule of thumb: NEXT_PUBLIC_* is bundled into client JS and visible to
# anyone — never put a secret, key, or token behind that prefix. Everything
# else below is server-only and must never be read from a "use client" file.
# ──────────────────────────────────────────────────────────────────────────

# ── AI (server-only) ────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MESSAGE_NUDGES_MODEL=gpt-4.1-mini

# ── Supabase (required in production) ───────────────────────────────────────
# Public: safe to expose. RLS (Perilla 7), not secrecy of these values, is
# what protects data — see docs/security/supabase-rls-service-role-boundary.md.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Bypasses RLS entirely — never expose to a client, never log
# unredacted, never put behind a NEXT_PUBLIC_ name. Missing in production
# fails closed (createPrivilegedSupabaseClient throws) rather than falling
# back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── App base URL (required in production) ───────────────────────────────────
# Public. Canonical origin used for invite-email links and as the allowlisted
# redirect/CORS origin (src/lib/security/origin-policy.ts). Must be a real
# https URL in production — localhost here in production is a hard failure
# (see environment.ts assertProductionEnvSafety).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public. Legacy alias for the same app base URL, consumed only by the
# Supabase signUp emailRedirectTo call (src/app/signup/actions.ts). Keep in
# sync with NEXT_PUBLIC_APP_URL — see known residual risks in the doc above.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Founder / internal access (server-only, optional) ───────────────────────
# Comma-separated list of emails granted founder/internal access in addition to
# the @pmfreak.ai / @onchainfest.xyz internal domains (see src/lib/auth.ts).
# Server-side only — never sourced from user input or user_metadata. Leaving
# this empty is safe (no extra grants) — it is not a fail-open condition.
FOUNDER_EMAIL_ALLOWLIST=

# ── Stripe billing (server secrets required in production) ─────────────────
# Server-only. Full Stripe account access if leaked.
STRIPE_SECRET_KEY=sk_test_...
# Public. Designed to be exposed to Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-only. Webhook route fails closed (400) if this is missing — see
# docs/security/stripe-webhook-billing-lifecycle-boundary.md.
STRIPE_WEBHOOK_SECRET=whsec_...
# Server-only (not secret, but must stay server-sourced — a client-suppliable
# price id would let a user choose their own plan price).
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PMO_PRICE_ID=price_...

# ── Federation webhook ingestion (server-only, optional) ────────────────────
# Shared secret authorizing inbound federation connector events
# (src/app/api/federation/webhooks/[connectorId]/route.ts). Missing = all
# inbound events treated as unauthorized (fails closed).
FEDERATION_WEBHOOK_SECRET=

# ── AOC governance / trust signing (server-only, optional) ──────────────────
PMFREAK_TRUST_EVENT_HMAC_SECRET=
PMFREAK_CAPABILITY_CLAIM_SECRET=
PMFREAK_AGENT_TOKEN_SECRET=

# ── Abuse protection (server-only, optional) ─────────────────────────────────
# Pepper used when hashing abuse-limit identifiers. Has a non-secret default;
# set a real value for stronger guarantees in production.
ABUSE_HASH_PEPPER=
