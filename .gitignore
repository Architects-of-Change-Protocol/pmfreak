# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# AOC workspace package build artifacts (rebuilt via `npm run build:aoc`)
/src/aoc/protocol/dist/
/src/aoc/enterprise/dist/

# Beta release gate per-run logs (scripts/check-beta-release.mjs)
/.beta-release-logs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.operational-flow.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local uploaded files
uploads/
.claude/
