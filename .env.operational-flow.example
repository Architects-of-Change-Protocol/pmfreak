# ──────────────────────────────────────────────────────────────────────────────
# Operational-flow runtime gate — environment variables
#
# CRITICAL: Use an isolated, throwaway Supabase project.
#           NEVER point these variables at a production Supabase project.
#           This gate creates and hard-deletes auth users, workspaces,
#           projects, evidence items, signals, decisions and audit records.
#
# Setup instructions: docs/operational-flow-runtime-gate.md
# ──────────────────────────────────────────────────────────────────────────────

# ── App (must match the Supabase project below) ───────────────────────────────

# Your isolated Supabase project URL  (e.g. http://localhost:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key from the isolated project
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — ONLY for local/test use, never commit, never use in prod
SUPABASE_SERVICE_ROLE_KEY=

# ── Runtime gate (check:operational-flow-db) ──────────────────────────────────

# Same URL as NEXT_PUBLIC_SUPABASE_URL above (duplicated so the gate script
# can run independently of the app env)
OPERATIONAL_FLOW_TEST_SUPABASE_URL=

# Same anon key as NEXT_PUBLIC_SUPABASE_ANON_KEY
OPERATIONAL_FLOW_TEST_ANON_KEY=

# Same service-role key as SUPABASE_SERVICE_ROLE_KEY
OPERATIONAL_FLOW_TEST_SERVICE_ROLE_KEY=

# Base URL where the Next.js app is running locally (must be same Supabase project)
OPERATIONAL_FLOW_TEST_BASE_URL=http://localhost:3000

# Explicit opt-in: this check creates and deletes real data.
# Must be the string "true" — any other value causes exit 2.
OPERATIONAL_FLOW_TEST_ALLOW_DESTRUCTIVE=true

# ── P2-13 Founder Invite seed harness (seed:p2-13-founder, check:p2-13-db) ────
#
# See docs/p2-13-founder-invite-seed-harness.md.
#
# The harness reuses the OPERATIONAL_FLOW_TEST_* target above and adds its own
# explicit opt-ins. It REFUSES to run unless the target is proven local and
# isolated: literal loopback host, Supabase API port 54321, database port
# 54322, app origin exactly http://localhost:3000, NODE_ENV not production,
# and no hosted/staging/production hostname. OPERATIONAL_FLOW_TEST_ALLOW_REMOTE
# is never honoured by P2-13 — a remote target is always refused.

# Explicit opt-in for preflight/seed/verify. Must be the string "true".
# Without it the harness exits 2 and creates nothing.
P2_13_FOUNDER_FIXTURE_ENABLED=true

# SECOND, separate opt-in required before reset/reseed may delete anything.
# Must be the string "true", AND OPERATIONAL_FLOW_TEST_ALLOW_DESTRUCTIVE must
# also be "true". Reset removes ONLY the deterministic P2-13 fixture scenario
# (its two workspaces, projects, invites, trial licences and fixture actors)
# from the disposable local database. It never truncates, drops a schema,
# resets migrations, disables RLS or disables a foreign key.
P2_13_ALLOW_LOCAL_RESET=true

# Password for the deterministic P2-13 fixture actors. Supplied ONLY by the
# environment — never hardcoded, never committed, never printed. At least 12
# characters. Local, disposable value only; it grants nothing beyond the
# throwaway fixture tenants in this local database.
P2_13_FIXTURE_ACTOR_PASSWORD=

# Optional recovery opt-in. Must be the string "true".
#
# If a deterministic fixture identity already exists but its password does not
# match P2_13_FIXTURE_ACTOR_PASSWORD (a rotated value, an earlier run), the
# harness FAILS with PARTIAL_SEED and names this variable. It never realigns
# silently: any password that merely passed the length check would otherwise
# become the fixture password, so a typo would rewrite working credentials and
# a seed that genuinely cannot authenticate would repair itself into looking
# successful. Set this only when you intend to realign the fixture accounts.
# P2_13_REALIGN_FIXTURE_ACTORS=true

# Database connection used ONLY by reset, for explicit reverse-dependency
# cleanup of the fixture scenario. Must be the loopback local database on port
# 54322. Same value as OPERATIONAL_FLOW_TEST_DATABASE_URL used by the P2-06..09
# gates.
# OPERATIONAL_FLOW_TEST_DATABASE_URL=postgresql://postgres:<local-password>@127.0.0.1:54322/postgres

# Optional. Name of the local Supabase database container to run reset SQL in,
# when `psql` is not on PATH. Only needed if more than one local Supabase stack
# is running, which the harness otherwise refuses as ambiguous.
# P2_13_DB_CONTAINER=supabase_db_pmfreak

# ── Optional ──────────────────────────────────────────────────────────────────

# Set to "true" only if your isolated project is on a non-localhost remote URL
# (e.g. a disposable Supabase branch project). The gate aborts by default if
# the URL does not resolve to localhost.
# OPERATIONAL_FLOW_TEST_ALLOW_REMOTE=true
